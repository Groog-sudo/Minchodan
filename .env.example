# Minchodan 환경변수 템플릿
# 이 파일을 복사해 .env 로 만든 뒤 실제 값을 채우십시오.
# .env 파일은 절대 커밋하지 마십시오.
# 상세 명세는 docs/ops/environment_variables.md를 참조하십시오.

# --- LLM / Ollama ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Docker Compose의 FastAPI 컨테이너가 호스트 로컬 Ollama에 접속할 때 사용합니다.
# Docker Desktop/Windows/Linux는 host.docker.internal, Colima(macOS)는 host.lima.internal 권장.
COMPOSE_OLLAMA_BASE_URL=http://host.docker.internal:11434
GEMMA_MODEL=gemma4:e4b
LLAVA_MODEL=llava
EMBEDDING_MODEL=nomic-embed-text

# OpenAI 전환 시 (LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...

# --- Vector DB (ChromaDB) ---
CHROMA_PATH=data/chroma_db
CHROMA_COLLECTION=safety_guidelines

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- WebSocket 서버 ---
WS_HOST=0.0.0.0
WS_PORT=8000

# --- 탐지 설정 ---
DETECTOR_TYPE=mock
YOLO_CONF=0.35
FRAME_SIZE=640
REFLEX_FPS=10
COGNITIVE_FPS=2

# --- 모델 가중치 경로 (커스텀 파인튜닝 완료 모델, git-ignore) ---
# object_detection.pt/segmentation.pt는 순정 COCO 사전학습 체크포인트(80클래스)이므로
# 절대 사용하지 말 것 - 아래 파인튜닝 완료 가중치(29/4클래스)만 사용한다.
YOLO26N_OBJECT_DET=server/models/yolo26n/det_best_20260705.pt
YOLO26N_SEG=server/models/yolo26n/segbest.pt

# --- TTS ---
# 지원 엔진은 piper뿐이다(kokoro/coqui는 미구현 - server/tts/tts_service.py 참조).
TTS_ENGINE=piper

# --- 데이터 경로 ---
AIHUB_WALK_DATASET_ROOT=C:\Users\USER\Desktop\dataset\인도보행 영상
DATA_RAW=data/raw
DATA_FRAMES=data/frames
DATA_DEDUPED=data/deduped
DATA_CAPTIONS=data/captions
DATA_REFLEX_CLIPS=data/reflex_clips

# --- 학습 환경 검증 (v1.1 C3) ---
# Blackwell sm_120 / CUDA 12.8 + cu128 PyTorch 휠 필수
# python scripts/verify_gpu.py 로 device_capability >= (12,0) 검증

# --- Slack Integration (Incoming Webhook 방식 단일화) ---
# Slack App Console > Incoming Webhooks에서 발급
# L3 가드레일 최종 실패 및 서버 크리티컬 예외 시 개발팀 채널로 경보 발행
SLACK_WEBHOOK_URL=

# --- LangSmith Trace (선택적 관측) ---
# LangSmith Platform에서 발급. 미설정 시 6단계 동작에 영향 없음.
# LANGCHAIN_API_KEY=
# LANGCHAIN_TRACING_V2=false

# --- GPU 모니터링 Mock (개발·테스트 전용, CUDA 미감지 환경) ---
# MOCK_GPU_USAGE_PCT=30.0
# MOCK_GPU_MEM_USED_MB=2048.0

# --- 데이터베이스 (MariaDB) ---
DB_TYPE=mariadb
DB_HOST=[IP_ADDRESS]
DB_PORT=3306
DB_NAME=minchodan_db
DB_USER=minchodan_team
DB_PASSWORD=[your_password]

# Docker Compose 로컬 MariaDB 컨테이너용
# COMPOSE_DB_*는 원격 DB용 DB_* 값과 분리된 로컬 compose 전용 계정입니다.
# DB_HOST_PORT는 호스트에서 MariaDB 컨테이너로 접속할 때만 사용합니다.
COMPOSE_DB_NAME=minchodan_db
COMPOSE_DB_USER=minchodan_team
COMPOSE_DB_PASSWORD=minchodan_password
COMPOSE_DB_ROOT_PASSWORD=minchodan_root_password
DB_HOST_PORT=3306

# --- Ngrok Authtoken (야외 도로 테스트 터널링용) ---
# NGROK_AUTHTOKEN=
