# Minchodan 환경변수 템플릿
# 이 파일을 복사해 .env 로 만든 뒤 실제 값을 채우십시오.
# .env 파일은 절대 커밋하지 마십시오.
# 상세 명세는 docs/ops/environment_variables.md를 참조하십시오.

# --- 일반 (서버 로깅) ---
# 서버 루트 로거 레벨. DEBUG는 개발 시 상세 추적용, INFO가 운영 기본값.
LOG_LEVEL=INFO

# --- LLM ---
# 시연/운영 기본: 상용 Gemini API (RTX4090은 YOLO/Whisper 등 서버 추론 전용, Ollama 미사용).
# Ollama는 로컬 테스트 전용(LLM_PROVIDER=ollama 시 host Ollama 필요).
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash-lite
# 음성 안내용 출력 토큰 상한(입력 컨텍스트 아님). 길면 TTS가 중간 절단될 수 있음.
GEMINI_MAX_OUTPUT_TOKENS=180
# GOOGLE_API_KEY=[Google AI Studio에서 발급 - 필수]
# OpenAI 전환 시 (LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Ollama (로컬 테스트 전용, 시연 시 미사용) ---
# LLM_PROVIDER=ollama 로 설정할 때만 사용. 시연 환경에서는 이 값을 비활성화 두세요.
OLLAMA_BASE_URL=http://localhost:11434
# systemd가 없는 WSL/컨테이너형 Linux에서는 시작 스크립트가 이 값으로 `ollama serve`를 띄웁니다.
# 기본은 로컬 루프백입니다. Linux Docker 컨테이너까지 붙여야 할 때만
# MINCHODAN_EXPOSE_OLLAMA=1과 OLLAMA_HOST=0.0.0.0:11434를 함께 사용하고,
# 172.18.0.0/16에서 172.18.0.1:11434로 향하는 트래픽만 호스트 방화벽에서 허용하십시오.
OLLAMA_HOST=127.0.0.1:11434
MINCHODAN_EXPOSE_OLLAMA=0
OLLAMA_KEEP_ALIVE=30m
OLLAMA_MAX_LOADED_MODELS=2
# Docker Compose의 FastAPI 컨테이너가 호스트 로컬 Ollama에 접속할 때 사용합니다.
# Linux Compose는 host.docker.internal을 고정 게이트웨이 172.18.0.1로 매핑합니다.
# Docker Desktop/Windows는 host.docker.internal, Colima(macOS)는 host.lima.internal 권장.
COMPOSE_OLLAMA_BASE_URL=http://host.docker.internal:11434
GEMMA_MODEL=gemma4:e4b
# LLAVA_MODEL은 4단계 캡셔닝 Gemini 전환(2026-07-07)으로 코드에서 미사용 (구 로컬 Llava 계획 잔재).
# .env.example에서도 제거(2026-07-14 정합성 검토). Gemini 캡셔닝은 GOOGLE_API_KEY 사용.
EMBEDDING_MODEL=nomic-embed-text

# --- 임베딩 ---
# 시연 환경(OLLAMA 미기동)에서는 EMBEDDING_PROVIDER=mock 권장(키워드 기반 결정론적 매칭).
# Ollama 로컬 테스트 시 EMBEDDING_PROVIDER=ollama + EMBEDDING_MODEL=nomic-embed-text.
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=nomic-embed-text

# --- 생활지원 RAG (음성 질문 convenience) ---
# 최초 실행 전 `ollama pull bge-m3` 후 `python scripts/build_convenience_db.py`를 실행합니다.
# 답변 LLM: ollama 기본, 실패 시 Gemini API 폴백 (CONVENIENCE_LLM_PROVIDER=ollama).
CONVENIENCE_LLM_PROVIDER=ollama
CONVENIENCE_EMBEDDING_PROVIDER=ollama
CONVENIENCE_EMBEDDING_MODEL=bge-m3
CONVENIENCE_CHROMA_PATH=data/chroma_db/convenience_guidelines
CONVENIENCE_CHROMA_COLLECTION=convenience_guidelines

# --- Vector DB (ChromaDB) ---
CHROMA_PATH=data/chroma_db
CHROMA_COLLECTION=safety_guidelines

# --- RAG 빌드 (Gemini VLM 캡셔닝, server/rag/build/gemini_captioner.py) ---
# Google AI Studio에서 발급. 4단계 오프라인 RAG 빌드(gemini-2.5-flash-lite) 시 필수 -
# 미설정 시 ValueError 발생(Mock 폴백 없음).
GOOGLE_API_KEY=

# --- Redis ---
REDIS_PASSWORD=[GENERATE_A_RANDOM_PASSWORD]
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379

# --- WebSocket 서버 ---
WS_HOST=0.0.0.0
WS_PORT=8000
# CORS 허용 주소 (JSON 배열 형식, 예: ["http://localhost:5174"])
# CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:5174"]

# --- 탐지 설정 ---
# yolo: 실측 랩/가중치 로드 (권장). mock: CPU 데모·CI 안전 폴백.
DETECTOR_TYPE=yolo
# Segmentation(YoloSegmentor) 신뢰도 임계값
YOLO_CONF=0.35
# Object Detection(YoloDetector) 신뢰도 임계값 (미설정 시 0.50)
YOLO_DET_CONF=0.50
FRAME_SIZE=640
REFLEX_FPS=10
COGNITIVE_FPS=2
# P0-2 (2026-07-17): 반사 큐 최신성 보장. 얕은 큐 + 신선도 검사로 지연 드리프트 방지.
REFLEX_QUEUE_MAXSIZE=2
COGNITIVE_QUEUE_MAXSIZE=4
REFLEX_MAX_AGE_S=0.4
COGNITIVE_MAX_AGE_S=2.0
# P0-1 (2026-07-17): 반사 억제 재무장 정책. 60s 무조건 침묵 -> 상황 변화 시 즉시 재발화.
REFLEX_SUPPRESS_TTL_S=5
REFLEX_MIN_GAP_S=1.5
REFLEX_NEAR_HAPTIC_THROTTLE_S=0.5
# 2026-07-20: near에서 동일 track_id 재발동 최소 간격(다른 물체는 위 500ms 스로틀만 적용).
REFLEX_NEAR_TRACK_MIN_GAP_S=1.2
# P0-3 (2026-07-17): 소형 객체 하단 근접 + Approach-Lost 재획득 즉시 재발화.
APPROACH_LOST_WINDOW_S=1.0
APPROACH_LOST_MIN_PREV_HIT=3
# P1-2 (2026-07-17): 인지 가이드 발화 가치 게이트. 동일 상황 30s 쿨다운.
COGNITIVE_UTTERANCE_COOLDOWN_S=30.0
# P2-1(b) (2026-07-17): surface_caution 반사 발동 히스테리시스. 연속 N 프레임 확인.
SURFACE_CAUTION_CONFIRM_STREAK=2
# 2026-07-19 신규, 2026-07-20 필드 DB 분석 기반 상향(5분간 8회 반복 완화): 노면(surface)
# 반사 전용 억제 TTL/최소 간격. 세그먼트 흔들림으로 매초 재발화하기 쉬워 일반 반사(5s)보다 길게.
REFLEX_SURFACE_SUPPRESS_TTL_S=30
REFLEX_SURFACE_MIN_GAP_S=15.0
# P2-2 (2026-07-17): 파이프라인 지연 관측 임계. 콘솔 latency_alert 표시 기준.
REFLEX_LATENCY_ALERT_MS=300
COGNITIVE_LATENCY_ALERT_MS=3000
# T2-G (2026-07-18): 저위험 순수 내레이션 발화 여부. false이면 측면·원거리·정적 객체의
# 단순 안내를 억제해 청각 피로를 줄인다. 보도 이탈·고위험·접근 객체·유의미 노면은 예외.
GUIDE_LOW_RISK_NARRATION=false
# 2026-07-20: Medium 인지 컨텍스트 소스. hints(기본)=인메모리 짧은 회피 힌트,
# rag=기존 Chroma 벡터검색(롤백/A/B). RAG_ENABLED는 mode=rag 일 때만 사용.
GUIDANCE_CONTEXT_MODE=hints
# RAG_ENABLED=true

# --- 모델 가중치 경로 (커스텀 파인튜닝 완료 모델, git-ignore) ---
# object_detection.pt/segmentation.pt는 순정 COCO 사전학습 체크포인트(80클래스)이므로
# 절대 사용하지 말 것 - 아래 파인튜닝 완료 가중치(29/4클래스)만 사용한다.
# 2026-07-14: object_detection260714.pt/segmentation260714.pt로 보완 학습된 가중치 교체.
# 기존 det_best_20260705.pt/segbest.pt는 롤백용으로 보존.
YOLO26N_OBJECT_DET=server/models/yolo26n/object_detection260714.pt
YOLO26N_SEG=server/models/yolo26n/segmentation260714.pt

# --- TTS ---
# 지원 엔진: supertonic(기본, MIT, 99M 파라미터 ONNX) / piper(구 엔진, 핫스왑 대비 보존) /
# pyttsx3(로컬 저사양 대체, GPU/네트워크 불필요). kokoro/coqui는 미구현 - server/tts/tts_service.py 참조.
TTS_ENGINE=supertonic
# Microsoft Edge Neural (네트워크 필요). 대안: ko-KR-InJoonNeural(남)
EDGE_TTS_VOICE=ko-KR-SunHiNeural
# 로컬 폴백용(TTS_ENGINE=supertonic 시): F2 + steps 12
SUPERTONIC_VOICE=F2
# 합성 품질(높을수록 자연·느림). 8=빠름, 12=권장, 16=최고품질.
SUPERTONIC_TOTAL_STEPS=12
# 인지 경로 기본 발화 속도(1.0=표준, 0.85=또렷한 안내).
TTS_DEFAULT_SPEED=0.85
# TTS 캐시 프리워밍(서버 기동 시 DB 이력에서 빈도 높은 안내 문장을 미리 합성).
# LIMIT은 RealtimeTTS.CACHE_MAX_ENTRIES(64)를 넘지 않아야 FIFO 축출로 밀려나지 않는다.
TTS_PREWARM_LIMIT=30
TTS_PREWARM_MIN_COUNT=2

# --- 데이터 경로 ---
AIHUB_WALK_DATASET_ROOT=C:\Users\USER\Desktop\dataset\인도보행 영상
DATA_RAW=data/raw
DATA_FRAMES=data/frames
DATA_DEDUPED=data/deduped
DATA_CAPTIONS=data/captions

# --- 이벤트 프레임 보존 (콘솔 오탐 검증용 상황 이미지) ---
# 탐지/안내 로그 적재 시점 프레임을 JPEG으로 보존하고 DB에는 경로만 남깁니다.
# 보행 중 촬영 이미지는 개인정보를 포함할 수 있어 기간 한정 보존만 허용합니다.
# EVENT_FRAMES_DIR=data/event_frames
EVENT_FRAME_RETENTION_DAYS=7
EVENT_FRAME_JPEG_QUALITY=80
# local: GPU 서버 로컬 디스크 저장, remote: Raspberry Pi 중앙 저장 API 사용.
EVENT_FRAME_STORAGE_BACKEND=local
# 중앙 저장 API 사용 시에만 설정합니다. 토큰은 실제 .env에만 저장하고 Git에 올리지 마십시오.
IMAGE_SERVER_BASE_URL=
IMAGE_SERVER_TOKEN=
IMAGE_UPLOAD_TIMEOUT_SECONDS=3
IMAGE_UPLOAD_MAX_RETRIES=1
# 다중 FastAPI writer 식별용. 예: gpu-macbook, gpu-desktop-a
WRITER_INSTANCE_ID=

# --- 학습 환경 검증 (v1.1 C3) ---
# 팀 GPU 서버 최대 RTX 5090. Ubuntu/Windows는 PyTorch 2.13 + cu130, macOS는 MPS/CPU
# python scripts/verify_gpu.py 로 운영체제별 실제 가속 연산 검증

# --- Navigation (TMAP 보행자 경로, server/navigation/) ---
# TMAP 개발자센터에서 발급. 미설정/플레이스홀더 방치 시 콘솔 경고와 함께 내비게이션 기능 비활성화.
# 단말 지도 패널(WebView + TMap JS API)에도 nav_route WS 메시지로 전달되어 앱 런타임에 노출되므로
# TMap 콘솔에서 키 사용 제한(도메인/앱 단위) 설정 권장.
TMAP_APP_KEY=YOUR_TMAP_APP_KEY_HERE

# --- Slack Integration (Webhook 우선 + Bot Token 폴백) ---
# 서버 크리티컬 경보 발송용. `server/mcp/slack_notifier.py`는 Webhook을 우선으로,
# Webhook 미설정 시 Bot Token + Channel ID로 폴백한다. 둘 중 하나는 설정 권장.
# Slack App > Incoming Webhooks에서 발급. 키 유출 시 즉시 회전할 것.
SLACK_WEBHOOK_URL=
# Webhook 폴백용. Slack App > OAuth & Permissions에서 Bot Token 발급.
SLACK_BOT_TOKEN=
# Bot Token 발송 대상 채널 ID. 미설정 시 코드 내 폴백값(C0BCZSB5TJS) 사용.
SLACK_CHANNEL_ID=

# --- LangSmith Trace (선택적 관측) ---
# LangSmith Platform에서 발급. 미설정 시 6단계 동작에 영향 없음.
# LANGCHAIN_API_KEY=
# LANGCHAIN_TRACING_V2=false

# --- GPU 모니터링 Mock (개발·테스트 전용, CUDA 미감지 환경) ---
# MOCK_GPU_USAGE_PCT=30.0
# MOCK_GPU_MEM_USED_MB=2048.0

# --- 데이터베이스 (MariaDB) ---
# Raspberry Pi 접속 경로 전환은 DB_HOST를 매번 직접 고치지 않고
# `.env.network.demo`/`.env.network.test`와 scripts/switch_rpi_network.sh를 사용합니다.
DB_TYPE=mariadb
DB_HOST=[IP_ADDRESS]
DB_PORT=3306
DB_NAME=minchodan_db
DB_USER=minchodan_team
DB_PASSWORD=[your_password]

# Docker Compose 로컬 MariaDB 컨테이너용
# COMPOSE_DB_*는 원격 DB용 DB_* 값과 분리된 로컬 compose 전용 계정입니다.
# DB_HOST_PORT는 호스트에서 MariaDB 컨테이너로 접속할 때만 사용합니다.
COMPOSE_DB_NAME=minchodan_db
COMPOSE_DB_USER=minchodan_team
COMPOSE_DB_PASSWORD=[GENERATE_A_RANDOM_PASSWORD]
COMPOSE_DB_ROOT_PASSWORD=[GENERATE_A_RANDOM_ROOT_PASSWORD]
DB_HOST_PORT=3306

# --- 인증 (2026-07-11 인증 기본값 분리, dev 개선 계획서 2절) ---
# 모든 환경에서 JWT_SECRET_KEY 미설정 또는 약한 값이면 서버 기동을 거부합니다.
# scripts/configure_security_secrets.py로 로컬 비밀값을 안전하게 생성할 수 있습니다.
APP_ENV=development
JWT_SECRET_KEY=[32_CHARACTERS_OR_LONGER_RANDOM_SECRET]
JWT_ISSUER=minchodan-api
JWT_AUDIENCE=minchodan-clients
ADMIN_BOOTSTRAP_TOKEN=[32_CHARACTERS_OR_LONGER_ONE_TIME_TOKEN]
ALLOW_STATIC_DEVICE_TOKENS=false
DEVICE_STATIC_TOKENS=
ENABLE_DEBUG_API=false
# production 에서만 false 시 /navigation 미마운트. development 는 콘솔 GPS HUD 용으로 기본 마운트.
ENABLE_NAVIGATION_SIMULATOR=false
