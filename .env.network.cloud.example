# Cloudflare R2 + 클라우드 MariaDB(gildang_db) 프로필 템플릿.
# 복사: cp .env.network.cloud.example .env.network.cloud
# 실값은 Git에 올리지 마십시오 (.gitignore: .env.network.cloud).

NETWORK_ENV_FILE=../.env.network.cloud

# --- MariaDB (클라우드, 포트 3307) ---
DB_HOST=[CLOUD_MARIADB_HOST]
DB_PORT=3307
DB_NAME=gildang_db
DB_USER=gildang
DB_PASSWORD=[APP_USER_PASSWORD]

# Docker Compose가 원격 클라우드 DB로 직접 붙도록 명시 (macOS socat 프록시 불필요)
COMPOSE_DB_HOST=[CLOUD_MARIADB_HOST]
COMPOSE_DB_PORT=3307

# --- 미디어: Cloudflare R2 ---
EVENT_FRAME_STORAGE_BACKEND=r2
R2_ACCOUNT_ID=[CLOUDFLARE_ACCOUNT_ID]
R2_ACCESS_KEY_ID=[R2_ACCESS_KEY_ID]
R2_SECRET_ACCESS_KEY=[R2_SECRET_ACCESS_KEY]
R2_BUCKET=[R2_BUCKET_NAME]
R2_ENDPOINT=https://[CLOUDFLARE_ACCOUNT_ID].r2.cloudflarestorage.com
# 공개 버킷/커스텀 도메인이 있을 때만 설정. 없으면 FastAPI가 GetObject/presign 사용.
R2_PUBLIC_BASE_URL=
R2_REGION=auto

# Pi IMAGE_SERVER는 cloud 프로필에서 사용하지 않음 (빈 값 유지)
IMAGE_SERVER_BASE_URL=
IMAGE_SERVER_TOKEN=
